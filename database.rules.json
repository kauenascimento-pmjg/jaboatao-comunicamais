{
  "rules": {
    "message_threads": {
      "$scope": {
        "$threadId": {
          "messages": {
            ".read": "auth != null",
            ".write": "auth != null"
          },
          "typing": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        }
      }
    },
    ".read": false,
    ".write": false
  }
}